# 레거시 PostgreSQL 및 기본 등록 연결: 본인 환경 값을 입력한다.
DATABASE_URL=
# 적응형 launcher는 loopback Ollama 주소만 허용한다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# models/Modelfile로 만든 레거시 모델 이름을 입력한다.
OLLAMA_MODEL=
# 선택: 비우면 일반 챗봇은 qwen2.5-coder:7b-instruct를 쓴다.
CHAT_MODEL=
# 선택: 비우면 mapping 제안은 qwen2.5-coder:7b-instruct를 쓴다.
MAPPING_MODEL=
# 선택: 적응형 개발용 SQL 표시를 끄려면 0을 입력한다.
SHOW_SQL=
# 선택: 레거시 Redis 캐시를 사용할 때만 연결 값을 입력한다.
REDIS_URL=
# 선택: 유료 외부 API이며 질문·공통 항목·값 힌트를 OpenAI로 보낸다.
OPENAI_API_KEY=
# 선택: 외부 API 모델을 지정한다. 비우면 gpt-5-mini를 쓴다.
OPENAI_MODEL=
# 선택: PG_SOURCE_<이름> 형식의 추가 연결이며 OTHER_SCHOOL은 이름 예시다.
PG_SOURCE_OTHER_SCHOOL=
