{
  "name": "course-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:adaptive-prototype": ".venv\\Scripts\\python.exe -m backend.adaptive.api.synthetic_prototype --port 8123",
    "dev:adaptive-full": "concurrently -k -n PROTOTYPE,FRONTEND -c blue,green \"npm run dev:adaptive-prototype\" \"npm run dev:frontend\"",
    "test:adaptive-prototype": "node --test tests/frontend/phase6-14-contracts.test.ts tests/frontend/phase6-14-client.test.ts tests/frontend/phase6-14-state.test.ts",
    "dev:frontend": "vite",
    "dev:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:full": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend:venv": ".venv\\Scripts\\python.exe -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "dev:all": "concurrently -k -n LEGACY,ADAPTIVE,FRONTEND -c blue,magenta,green \"npm run dev:backend:venv\" \"npm run dev:adaptive-prototype\" \"npm run dev:frontend\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
